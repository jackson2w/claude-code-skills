{#- schema.org JSON-LD, one @graph per page, cross-linked by @id (seo/structured-data, seo/breadcrumbs). -#}
{%- set canonical = site.url + page.url -%}
{%- set person = { "@type": "Person", "@id": site.url + "/#person", "name": site.author.name, "url": site.author.url } -%}
{%- set orgNode = { "@type": "Organization", "@id": site.url + "/#org", "name": site.org.name, "url": site.url + "/",
    "logo": { "@type": "ImageObject", "url": site.url + site.org.logo, "width": 512, "height": 512 } } -%}
{%- set pub = person if site.publisher == "person" else orgNode -%}
{%- set website = { "@type": "WebSite", "@id": site.url + "/#website", "url": site.url + "/", "name": site.name,
    "description": site.description, "inLanguage": site.lang, "publisher": { "@id": pub["@id"] } } -%}
{%- set crumbs = [{ "@type": "ListItem", "position": 1, "name": site.name, "item": site.url + "/" }] -%}
{%- for c in (breadcrumbs or []) -%}
  {%- set _ = crumbs.push({ "@type": "ListItem", "position": loop.index + 1, "name": c.name, "item": site.url + c.url }) -%}
{%- endfor -%}
{%- if page.url != "/" -%}
  {%- set _ = crumbs.push({ "@type": "ListItem", "position": crumbs.length + 1, "name": title }) -%}
{%- endif -%}
{%- if ldKind == "home" or page.url == "/" -%}
  {%- set graph = [website, pub] -%}
{%- elif ldKind == "post" -%}
  {%- set graph = [
    { "@type": "BlogPosting", "@id": canonical + "#post", "mainEntityOfPage": canonical, "headline": title,
      "description": description, "image": [site.url + (ogImage or site.ogImage)], "datePublished": date | dateToRfc3339,
      "dateModified": (updated or date) | dateToRfc3339, "inLanguage": site.lang,
      "author": author or { "@id": site.url + "/#person" }, "publisher": { "@id": pub["@id"] }, "isPartOf": { "@id": site.url + "/#website" } },
    { "@type": "BreadcrumbList", "itemListElement": crumbs }, pub ] -%}
{%- else -%}
  {%- set graph = [
    { "@type": "CollectionPage" if ldKind == "collection" else "WebPage", "@id": canonical, "url": canonical, "name": title,
      "description": description, "inLanguage": site.lang, "isPartOf": { "@id": site.url + "/#website" } },
    { "@type": "BreadcrumbList", "itemListElement": crumbs } ] -%}
{%- endif %}
  <script type="application/ld+json">{{ { "@context": "https://schema.org", "@graph": graph } | dump | replace("</", "<\\/") | safe }}</script>
